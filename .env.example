# ------------------------------------------------------------
# FRAME — environment
# Copy to .env (never commit .env). Vite exposes only VITE_* keys.
# Every value below is optional: the defaults build the real product
# (LIVE mode, Robinhood Chain mainnet, LI.FI routes).
# ------------------------------------------------------------

# live (default) | demo
#   live → real vault, real RPC, real transactions
#   demo → the in-process simulator used by the test-suite (labelled, nothing is broadcast)
VITE_APP_MODE=live

# mainnet (default) | testnet — default network for LIVE builds
VITE_NETWORK_MODE=mainnet

# Optional dedicated RPC providers (leave empty to use the public endpoints).
# Never put API keys in source — only here, and only on your machine / CI secrets.
VITE_RPC_ROBINHOOD_MAINNET=
VITE_RPC_ROBINHOOD_TESTNET=
# Bridge SOURCE chains only.
VITE_RPC_ETHEREUM=
VITE_RPC_ARBITRUM=
VITE_RPC_BASE=

# Route provider for swaps and bridges (LI.FI public API by default). "off" disables both.
VITE_LIFI_API_URL=https://li.quest/v1

# Market data (no key required for the default providers).
VITE_MARKET_DATA=live

# Web app only: same-origin relays served by /api (see api/rpc.ts, api/market.ts).
# Production builds default to /api/rpc and /api/market; "off" forces direct upstream calls.
VITE_RPC_RELAY=
VITE_MARKET_RELAY=

# Website links
VITE_APP_URL=/app/
VITE_DOWNLOAD_URL=/download
