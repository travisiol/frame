# ------------------------------------------------------------
# FRAME — environment
# Copy to .env (never commit .env). Vite exposes only VITE_* keys.
# ------------------------------------------------------------

# demo | live
#   demo → simulated chain + demo portfolio, clearly labelled, nothing is broadcast
#   live → real vault, real RPC, real transactions
VITE_APP_MODE=demo

# testnet | mainnet  (default network for LIVE builds — testnet first, always)
VITE_NETWORK_MODE=testnet

# Optional dedicated RPC providers (leave empty to use the public fallbacks).
# Never put API keys in source — only here, and only on your machine / CI secrets.
VITE_RPC_ROBINHOOD_MAINNET=
VITE_RPC_ROBINHOOD_TESTNET=
# Ethereum mainnet is only used as a bridge SOURCE chain.
VITE_RPC_ETHEREUM=

# Liquidity / bridge aggregator endpoints (adapters are only enabled when set).
VITE_LIFI_API_URL=https://li.quest/v1

# Market data (no key required for the default providers; leave as-is).
VITE_MARKET_DATA=live

# Landing page → demo link
VITE_DEMO_URL=/demo/
